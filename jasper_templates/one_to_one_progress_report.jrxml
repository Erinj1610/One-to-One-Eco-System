    <!-- ================================================================= -->
    <!-- TITLE BAND                                                        -->
    <!-- ================================================================= -->
    <title>
        <band height="68" splitType="Stretch">
            <!-- Left Company Info -->
            <textField>
                <reportElement x="0" y="0" width="280" height="48" forecolor="#334155" uuid="1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d"/>
                <textElement>
                    <font fontName="SansSerif" size="8" isBold="false"/>
