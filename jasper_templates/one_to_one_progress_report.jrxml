    <parameter name="CompanyName" class="java.lang.String">
        <defaultValueExpression><![CDATA["1TO1 Design Studio"]]></defaultValueExpression>
    </parameter>
    <parameter name="CompanyAddress" class="java.lang.String">
        <defaultValueExpression><![CDATA["3 Ravenscraig Road, Woodstock\nUnit 09 The Stockyard\nCape Town, 7925"]]></defaultValueExpression>
    </parameter>
    <parameter name="VatNumber" class="java.lang.String">
        <defaultValueExpression><![CDATA["4590312965"]]></defaultValueExpression>
    </parameter>
    <parameter name="RegNumber" class="java.lang.String">
        <defaultValueExpression><![CDATA["2022/863083/07"]]></defaultValueExpression>
