                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="16" isBold="true" isUnderline="true"/>
                </textElement>
                <text><![CDATA[PROGRESS REPORT]]></text>
            </staticText>
        </band>
    </title>

    <!-- ================================================================= -->
    <!-- DETAIL BAND (Each item row in the progress report)                -->
    <!-- ================================================================= -->
    <detail>
        <band height="18" splitType="Prevent">
            <!-- Alternating background bar -->
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="18" backcolor="#FFFFFF" uuid="d1e2f3a4-b5c6-7d8e-9f0a-1b2c3d4e5f6a">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 1]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="18" backcolor="#F8FAFC" uuid="e2f3a4b5-c6d7-8e9f-0a1b-2c3d4e5f6a7b">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>

            <!-- Qty -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="28" height="18" uuid="4d5e6f7a-8b9c-0d1e-2f3a-4b5c6d7e8f9a"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression>
            </textField>

            <!-- 1:1 Code -->
            <textField isBlankWhenNull="true">
                <reportElement x="28" y="0" width="55" height="18" forecolor="#0F766E" uuid="5e6f7a8b-9c0d-1e2f-3a4b-5c6d7e8f9a0b"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Courier New" size="7.5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{oneOneCode} != null ? $F{oneOneCode} : "—"]]></textFieldExpression>
            </textField>

            <!-- Made Code -->
            <textField isBlankWhenNull="true">
                <reportElement x="83" y="0" width="70" height="18" uuid="6f7a8b9c-0d1e-2f3a-4b5c-6d7e8f9a0b1c"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Courier New" size="7.5"/>
                    <paragraph leftIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{madeCode} != null ? $F{madeCode} : "—"]]></textFieldExpression>
            </textField>

            <!-- Description -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="153" y="0" width="165" height="18" uuid="7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7.5"/>
                    <paragraph leftIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>

            <!-- Progress (Received vs Back Order badge) -->
            <textField isBlankWhenNull="true">
                <reportElement x="318" y="0" width="48" height="18" forecolor="#B45309" uuid="8b9c0d1e-2f3a-4b5c-6d7e-8f9a0b1c2d3e">
                    <printWhenExpression><![CDATA[$F{progress} != null && !"Received".equalsIgnoreCase($F{progress})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7.5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{progress} != null ? $F{progress} : "Back Order"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="318" y="0" width="48" height="18" forecolor="#16A34A" uuid="9c0d1e2f-3a4b-5c6d-7e8f-9a0b1c2d3e4f">
                    <printWhenExpression><![CDATA["Received".equalsIgnoreCase($F{progress})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7.5" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Received"]]></textFieldExpression>
            </textField>

            <!-- Received -->
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="366" y="0" width="42" height="18" uuid="0d1e2f3a-4b5c-6d7e-8f9a-0b1c2d3e4f5a"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7.5" isBold="true"/>
                    <paragraph rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{received}]]></textFieldExpression>
            </textField>

            <!-- Back Order -->
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="408" y="0" width="45" height="18" forecolor="#B91C1C" uuid="1e2f3a4b-5c6d-7e8f-9a0b-1c2d3e4f5a6b"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7.5" isBold="true"/>
                    <paragraph rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{backOrder}]]></textFieldExpression>
            </textField>

            <!-- ETA -->
            <textField isBlankWhenNull="true">
                <reportElement x="453" y="0" width="52" height="18" uuid="2f3a4b5c-6d7e-8f9a-0b1c-2d3e4f5a6b7c"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{eta}]]></textFieldExpression>
            </textField>

            <!-- Date Delivered -->
            <textField isBlankWhenNull="true">
                <reportElement x="505" y="0" width="50" height="18" forecolor="#475569" uuid="3a4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dateDelivered} != null ? $F{dateDelivered} : "—"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

