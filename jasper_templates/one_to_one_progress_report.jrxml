                </textElement>
                <textFieldExpression><![CDATA[$P{CompanyAddress} + "\nVAT No: " + $P{VatNumber} + "\nReg No: " + $P{RegNumber}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="0" y="48" width="280" height="14" forecolor="#0F172A" uuid="2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + $P{ReportDate}]]></textFieldExpression>
            </textField>

            <!-- Center/Right Title -->
            <staticText>
