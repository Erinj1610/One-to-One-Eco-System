        <defaultValueExpression><![CDATA["2 June 2026"]]></defaultValueExpression>
    </parameter>
    <parameter name="ProjectName" class="java.lang.String">
        <defaultValueExpression><![CDATA["House Botha"]]></defaultValueExpression>
    </parameter>

    <!-- ================================================================= -->
    <!-- FIELDS (Dynamic row data for progress report items)              -->
    <!-- ================================================================= -->
    <field name="sectionTitle" class="java.lang.String">
        <fieldDescription><![CDATA[Grouping section e.g. Entrance & Dining, Decorative Lighting]]></fieldDescription>
    </field>
    <field name="qty" class="java.lang.Integer"/>
